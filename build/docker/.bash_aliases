alias gaa='git add -A'
alias gc='git commit'
alias gca='git commit -a'
alias gf='git fetch'
alias gk='gitk --all'
alias gp='git pull'
alias gps='git push origin HEAD'
alias gs='git status'

alias sa='source /usr/local/bin/ssh-add.sh'

alias gsr='git submodule init && git submodule update --recursive && git clean -fdx'


# make aliases
alias ma='make agent'
alias mc-='make clean'
alias ms='make speed'

alias gp='make godot_play'
