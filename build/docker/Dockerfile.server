# ============================================================
# lotr-server -- server container
# Base: Python 3.11 slim
#
# This container runs the FastAPI server for online play support.
#
# Build:
#   docker build -t lotr-server build/docker/
# Run:
#   docker run -d --name lotr-server -p 8000:8000 lotr-server
# Stop:
#   docker stop lotr-server && docker rm lotr-server
#
# The server will automatically start when the godot_play target is run.
# ============================================================

FROM python:3.11-slim

ARG DEBIAN_FRONTEND=noninteractive

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy requirements first for better caching
COPY pyproject.toml .

# Install Python dependencies
RUN pip install --no-cache-dir --upgrade pip setuptools wheel \
    && pip install --no-cache-dir fastapi uvicorn

# Copy application code
COPY . /app

# Environment setup
ENV PYTHONPATH=/app \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

# Expose port
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Start the server
CMD ["uvicorn", "server.server.app:app", "--host", "0.0.0.0", "--port", "8000"]
