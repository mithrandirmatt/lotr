
include ./makefiles/common.mk
include ./makefiles/speed.mk

# Removes a path with rm -rf, retrying a few times if it can't be fully
# removed on the first attempt (e.g. ENOTEMPTY because another build process
# -- like wiki_process_card_images's parallel workers -- is still writing
# into it). Fails the recipe only if the path still exists after all retries.
define SAFE_RM
	@n=0; \
	while [ $$n -lt 5 ]; do \
		if rm -rf $(1); then break; fi; \
		n=$$((n + 1)); \
		echo "  rm -rf $(1) failed (attempt $$n/5) -- a concurrent process may still be writing there; retrying in 1s..."; \
		sleep 1; \
	done; \
	if [ -e $(1) ]; then \
		echo "ERROR: could not remove $(1) after 5 attempts. Make sure no other build/make process is running concurrently, then retry."; \
		exit 1; \
	fi
endef


clean:
	$(call log_build,** Calling $@... **)

	@if [ -d $(REPO_ROOT)/build/do ]; then \
		find $(REPO_ROOT)/build/do/ -mindepth 1 -maxdepth 1 ! -name 'assets' -exec rm -rf {} + ; \
	else \
		echo "  build/do/ does not exist -- nothing to clean."; \
	fi

	$(call log_ok,Finished $@.)

# super_clean: wipe every autogenerated/persistent artifact produced by the
# wiki/godot/admin/server build pipeline (everything `make speed` produces),
# forcing a full from-scratch rebuild on the next `make speed` run.
#
# Covers:
#   - build/do/           -- wiki-gathered assets (raw HTML, card JPGs),
#                             processed card PNGs, generated databases
#                             (card/xlist/errata/starter/game_logic JSON),
#                             Godot export output, and all wiki/admin/godot
#                             build caches (.cache/*.stamp.json)
#   - gotdot/assets/cards  -- processed card PNGs synced into the Godot project
#   - gotdot/assets/data   -- databases synced into the Godot project
#   - frontend/admin-panel/node_modules, dist -- admin panel install/build output
#   - server/.venv, dist, lotr_server.egg-info, .pytest_cache -- server
#     build/install/test artifacts
#   - .speed-cache         -- make speed's own cache directory
#
# Deliberately does NOT touch:
#   - the agent/LLM fine-tuning pipeline (do/agent/models, build/do/agent,
#     build/docker/cache/agent) -- use `make agent_clean` for that; those
#     artifacts are expensive to regenerate and are not part of `make speed`.
#   - server/lotr.db -- runtime application data, not a build artifact.
#   - .github/agents/generated/ -- commit-ready generated files, not a
#     throwaway build cache.
super_clean:
	$(call log_build,** Calling $@... **)

	$(MAKE) clean

	@echo "Removing build/do/ (wiki assets, databases, godot export, all build caches)..."
	$(call SAFE_RM,$(REPO_ROOT)/build/do)

	@echo "Removing card images/databases synced into the Godot project..."
	$(call SAFE_RM,$(REPO_ROOT)/gotdot/assets/cards)
	$(call SAFE_RM,$(REPO_ROOT)/gotdot/assets/data)

	@echo "Removing admin panel node_modules and build output..."
	$(call SAFE_RM,$(REPO_ROOT)/frontend/admin-panel/node_modules)
	$(call SAFE_RM,$(REPO_ROOT)/frontend/admin-panel/dist)

	@echo "Removing server build/install/test artifacts..."
	$(call SAFE_RM,$(REPO_ROOT)/server/.venv)
	$(call SAFE_RM,$(REPO_ROOT)/server/dist)
	$(call SAFE_RM,$(REPO_ROOT)/server/lotr_server.egg-info)
	$(call SAFE_RM,$(REPO_ROOT)/server/.pytest_cache)

	@echo "Removing make speed cache..."
	$(call SAFE_RM,$(REPO_ROOT)/.speed-cache)

	$(call log_warning,Note: agent/LLM fine-tuning artifacts (do/agent/models) are NOT touched -- use 'make agent_clean' for that.)
	$(call log_ok,Finished $@.)
all:
	$(call log_build,** Calling $@... **)



	$(call log_ok,Finished $@.)

# =============================================================================
# speed.mk integration points (documented for future development)
# =============================================================================
# To add new phases or targets to make speed:
# 1. Add target names to PREBUILD_TARGETS, PARALLEL_TARGETS, or POSTBUILD_TARGETS
# 2. The orchestration automatically handles dependency ordering
# 3. Parallel jobs are limited by NPROCS (auto-detected)
# =============================================================================

.PHONY: speed-help
speed-help:
	@echo "make speed - Full project build with caching"
	@echo ""
	@echo "Usage:"
	@echo "  make speed              # Build everything from scratch"
	@echo "  make speed-clean        # Clean only speed cache (preserves source)"
	@echo "  make speed-verify       # Verify build artifacts after speed completes"
	@echo "  make clean              # Remove build/do/ output except assets/"
	@echo "  make super_clean        # Remove ALL autogenerated build output (cards, databases, godot export, admin/server artifacts)"
	@echo ""
	@echo "Variables:"
	@echo "  NPROCS=n                # Override processor count (default: auto-detected)"
	@echo "  SPEED_CACHE_DIR=path    # Custom cache directory location"