{
  "name": "rx7900xtx-agentic",
  "description": "AMD RX 7900 XTX optimized profile for local agentic coding assistants",
  "gpu": {
    "name": "AMD Radeon RX 7900 XTX",
    "vram_gb": 24,
    "recommended_quantization": "Q5_K_M",
    "max_practical_params_for_coding": "14B-32B (quantized, task-dependent)"
  },
  "runtime": {
    "num_ctx": 32768,
    "num_predict": 4096,
    "temperature": 0.2,
    "top_p": 0.9,
    "top_k": 40,
    "repeat_penalty": 1.08,
    "mirostat": 0,
    "seed": 42
  },
  "lora": {
    "epochs": 1,
    "batch_size": 1,
    "grad_accum": 16,
    "learning_rate": 0.0001,
    "warmup_ratio": 0.03,
    "max_seq_length": 2048,
    "lora_r": 16,
    "lora_alpha": 32,
    "lora_dropout": 0.05,
    "target_modules": [
      "q_proj",
      "k_proj",
      "v_proj",
      "o_proj",
      "gate_proj",
      "up_proj",
      "down_proj"
    ]
  },
  "model_preferences": {
    "balanced": [
      "qwen2.5-coder:7b",
      "qwen2.5-coder:14b",
      "deepseek-coder-v2:16b"
    ],
    "reasoning_heavy": [
      "qwen2.5:32b",
      "llama3.1:70b (remote/offload only)"
    ]
  },
  "include_globs": [
    ".github/copilot-instructions.md",
    ".github/agent/rules.md",
    ".github/agent/**/*.md",
    "assets/reference/agent/**/*.md",
    "build/agent/**/*.py",
    "build/agent/**/*.md",
    "build/makefiles/agent.mk",
    "server/**/*.py",
    "frontend/admin-panel/src/**/*.ts",
    "frontend/admin-panel/src/**/*.tsx",
    "frontend/admin-panel/src/**/*.js",
    "frontend/admin-panel/src/**/*.jsx",
    "frontend/admin-panel/src/**/*.css",
    "frontend/admin-panel/src/**/*.scss",
    "gotdot/scripts/**/*.gd",
    "README.md"
  ],
  "exclude_globs": [
    "**/.git/**",
    "**/.venv/**",
    "**/node_modules/**",
    "**/build/docker/models/**",
    "**/*.png",
    "**/*.jpg",
    "**/*.jpeg",
    "**/*.gif",
    "**/*.webp",
    "**/*.pdf",
    "**/*.zip",
    "**/*.tar",
    "**/*.gguf"
  ]
}
