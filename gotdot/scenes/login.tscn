[gd_scene load_steps=3 format=3 uid="uid://lotr_login"]

[ext_resource type="Script" path="res://scripts/login.gd" id="1_login"]

; ── Login Screen ─────────────────────────────────────────────────────────────────
; First-time user experience: Sign In / Register pages
; Shows welcome screen, then Sign In (with mandatory 2FA challenge) or Register

[node name="Login" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_login")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.05, 0.07, 0.15, 1)

[node name="EmailCheckTimer" type="Timer" parent="."]
wait_time = 0.5
one_shot = true

[node name="NameCheckTimer" type="Timer" parent="."]
wait_time = 0.5
one_shot = true

[node name="CanvasLayer" type="CanvasLayer" parent="."]
layer = 1

[node name="WelcomeBox" type="VBoxContainer" parent="CanvasLayer"]
offset_left = 300.0
offset_top = 150.0
offset_right = 980.0
offset_bottom = 420.0
alignment = 1
visible = true

[node name="WelcomeTitle" type="Label" parent="CanvasLayer/WelcomeBox"]
layout_mode = 2
text = "Welcome to LotR TCG"
theme_override_font_sizes/font_size = 48
horizontal_alignment = 1
theme_override_colors/font_color = Color(1, 0.85, 0.35, 1)

[node name="WelcomeSubtitle" type="Label" parent="CanvasLayer/WelcomeBox"]
layout_mode = 2
text = "Choose your option to begin"
theme_override_font_sizes/font_size = 20
horizontal_alignment = 1
theme_override_colors/font_color = Color(0.8, 0.8, 0.8, 1)

[node name="WelcomeImage" type="Label" parent="CanvasLayer/WelcomeBox"]
layout_mode = 2
text = "[🏰]"
theme_override_font_sizes/font_size = 80
horizontal_alignment = 1
theme_override_colors/font_color = Color(1, 0.9, 0.5, 1)

[node name="SignInBtnWelcome" type="Button" parent="CanvasLayer/WelcomeBox"]
layout_mode = 2
custom_minimum_size = Vector2(280, 50)
text = "Sign In"
theme_override_colors/font_color = Color(0, 0, 0, 1)
theme_override_colors/normal_color = Color(0.2, 0.4, 0.6, 0.5)
theme_override_colors/pressed_color = Color(0.1, 0.3, 0.5, 0.6)
theme_override_colors/hover_color = Color(0.3, 0.5, 0.7, 0.4)

[node name="RegisterBtnWelcome" type="Button" parent="CanvasLayer/WelcomeBox"]
layout_mode = 2
custom_minimum_size = Vector2(280, 50)
text = "Register"
theme_override_colors/font_color = Color(0, 0, 0, 1)
theme_override_colors/normal_color = Color(0.2, 0.4, 0.6, 0.5)
theme_override_colors/pressed_color = Color(0.1, 0.3, 0.5, 0.6)
theme_override_colors/hover_color = Color(0.3, 0.5, 0.7, 0.4)

[node name="SignInBox" type="VBoxContainer" parent="CanvasLayer"]
offset_left = 300.0
offset_top = 150.0
offset_right = 980.0
offset_bottom = 460.0
alignment = 1
visible = false

[node name="SignInTitle" type="Label" parent="CanvasLayer/SignInBox"]
layout_mode = 2
text = "Sign In"
theme_override_font_sizes/font_size = 36
horizontal_alignment = 1
theme_override_colors/font_color = Color(1, 0.85, 0.35, 1)

[node name="SignInForm" type="VBoxContainer" parent="CanvasLayer/SignInBox"]
layout_mode = 2
offset_left = 20.0
offset_top = 40.0
offset_right = 960.0
offset_bottom = 380.0
theme_override_constants/separation = 16

[node name="EmailLabel" type="Label" parent="CanvasLayer/SignInBox/SignInForm"]
text = "Email"
theme_override_font_sizes/font_size = 14
theme_override_colors/font_color = Color(0.8, 0.8, 0.8, 1)

[node name="EmailInput" type="LineEdit" parent="CanvasLayer/SignInBox/SignInForm"]
layout_mode = 2
placeholder_text = "Enter your email"
theme_override_font_sizes/font_size = 16
theme_override_colors/font_color = Color(1, 1, 1, 1)
theme_override_colors/placeholder_color = Color(0.5, 0.5, 0.5, 1)

[node name="PasswordLabel" type="Label" parent="CanvasLayer/SignInBox/SignInForm"]
text = "Password"
theme_override_font_sizes/font_size = 14
theme_override_colors/font_color = Color(0.8, 0.8, 0.8, 1)

[node name="PasswordInput" type="LineEdit" parent="CanvasLayer/SignInBox/SignInForm"]
layout_mode = 2
placeholder_text = "Enter your password"
theme_override_font_sizes/font_size = 16
theme_override_colors/font_color = Color(1, 1, 1, 1)
theme_override_colors/placeholder_color = Color(0.5, 0.5, 0.5, 1)
secret = true

[node name="SignInBtn" type="Button" parent="CanvasLayer/SignInBox/SignInForm"]
layout_mode = 2
custom_minimum_size = Vector2(250, 45)
text = "Sign In"
theme_override_colors/font_color = Color(0, 0, 0, 1)

[node name="RegisterLinkBtn" type="Button" parent="CanvasLayer/SignInBox/SignInForm"]
layout_mode = 2
flat = true
text = "Don't have an account? Register"
theme_override_font_sizes/font_size = 14
theme_override_colors/font_color = Color(1, 0.85, 0.35, 1)

[node name="BackToWelcomeBtn" type="Button" parent="CanvasLayer/SignInBox/SignInForm"]
layout_mode = 2
flat = true
text = "← Back to Welcome"
theme_override_font_sizes/font_size = 12
theme_override_colors/font_color = Color(0.5, 0.5, 0.5, 1)

[node name="MfaBox" type="VBoxContainer" parent="CanvasLayer"]
offset_left = 300.0
offset_top = 150.0
offset_right = 980.0
offset_bottom = 420.0
alignment = 1
visible = false

[node name="MfaTitle" type="Label" parent="CanvasLayer/MfaBox"]
layout_mode = 2
text = "Two-Factor Authentication"
theme_override_font_sizes/font_size = 32
horizontal_alignment = 1
theme_override_colors/font_color = Color(1, 0.85, 0.35, 1)

[node name="MfaForm" type="VBoxContainer" parent="CanvasLayer/MfaBox"]
layout_mode = 2
offset_left = 20.0
offset_top = 40.0
offset_right = 960.0
offset_bottom = 300.0
theme_override_constants/separation = 16

[node name="MfaSubtitle" type="Label" parent="CanvasLayer/MfaBox/MfaForm"]
text = "Enter your 6-digit authentication code"
theme_override_font_sizes/font_size = 14
horizontal_alignment = 1
theme_override_colors/font_color = Color(0.8, 0.8, 0.8, 1)

[node name="MfaCodeInput" type="LineEdit" parent="CanvasLayer/MfaBox/MfaForm"]
layout_mode = 2
placeholder_text = "000000"
max_length = 6
horizontal_alignment = 1
theme_override_font_sizes/font_size = 24
theme_override_colors/font_color = Color(1, 1, 1, 1)
theme_override_colors/placeholder_color = Color(0.5, 0.5, 0.5, 1)

[node name="MfaSubmitBtn" type="Button" parent="CanvasLayer/MfaBox/MfaForm"]
layout_mode = 2
custom_minimum_size = Vector2(250, 45)
text = "Verify"
theme_override_colors/font_color = Color(0, 0, 0, 1)

[node name="MfaBackBtn" type="Button" parent="CanvasLayer/MfaBox/MfaForm"]
layout_mode = 2
flat = true
text = "← Back to Sign In"
theme_override_font_sizes/font_size = 12
theme_override_colors/font_color = Color(0.5, 0.5, 0.5, 1)

[node name="RegisterBox" type="VBoxContainer" parent="CanvasLayer"]
offset_left = 300.0
offset_top = 100.0
offset_right = 980.0
offset_bottom = 620.0
alignment = 1
visible = false

[node name="RegisterTitle" type="Label" parent="CanvasLayer/RegisterBox"]
layout_mode = 2
text = "Create Account"
theme_override_font_sizes/font_size = 36
horizontal_alignment = 1
theme_override_colors/font_color = Color(1, 0.85, 0.35, 1)

[node name="RegisterForm" type="VBoxContainer" parent="CanvasLayer/RegisterBox"]
layout_mode = 2
offset_left = 20.0
offset_top = 40.0
offset_right = 960.0
offset_bottom = 520.0
theme_override_constants/separation = 10

[node name="NameLabel" type="Label" parent="CanvasLayer/RegisterBox/RegisterForm"]
text = "Unique Name"
theme_override_font_sizes/font_size = 14
theme_override_colors/font_color = Color(0.8, 0.8, 0.8, 1)

[node name="NameInput" type="LineEdit" parent="CanvasLayer/RegisterBox/RegisterForm"]
layout_mode = 2
placeholder_text = "Choose a unique name"
theme_override_font_sizes/font_size = 16
theme_override_colors/font_color = Color(1, 1, 1, 1)
theme_override_colors/placeholder_color = Color(0.5, 0.5, 0.5, 1)

[node name="NameStatus" type="Label" parent="CanvasLayer/RegisterBox/RegisterForm"]
text = ""
theme_override_font_sizes/font_size = 12

[node name="EmailLabel2" type="Label" parent="CanvasLayer/RegisterBox/RegisterForm"]
text = "Email"
theme_override_font_sizes/font_size = 14
theme_override_colors/font_color = Color(0.8, 0.8, 0.8, 1)

[node name="EmailInput2" type="LineEdit" parent="CanvasLayer/RegisterBox/RegisterForm"]
layout_mode = 2
placeholder_text = "Enter your email"
theme_override_font_sizes/font_size = 16
theme_override_colors/font_color = Color(1, 1, 1, 1)
theme_override_colors/placeholder_color = Color(0.5, 0.5, 0.5, 1)

[node name="EmailStatus" type="Label" parent="CanvasLayer/RegisterBox/RegisterForm"]
text = ""
theme_override_font_sizes/font_size = 12

[node name="PasswordLabel2" type="Label" parent="CanvasLayer/RegisterBox/RegisterForm"]
text = "Password"
theme_override_font_sizes/font_size = 14
theme_override_colors/font_color = Color(0.8, 0.8, 0.8, 1)

[node name="PasswordInput2" type="LineEdit" parent="CanvasLayer/RegisterBox/RegisterForm"]
layout_mode = 2
placeholder_text = "Create a password (min. 8 characters)"
theme_override_font_sizes/font_size = 16
theme_override_colors/font_color = Color(1, 1, 1, 1)
theme_override_colors/placeholder_color = Color(0.5, 0.5, 0.5, 1)
secret = true

[node name="ConfirmPasswordLabel" type="Label" parent="CanvasLayer/RegisterBox/RegisterForm"]
text = "Confirm Password"
theme_override_font_sizes/font_size = 14
theme_override_colors/font_color = Color(0.8, 0.8, 0.8, 1)

[node name="ConfirmPasswordInput" type="LineEdit" parent="CanvasLayer/RegisterBox/RegisterForm"]
layout_mode = 2
placeholder_text = "Re-enter your password"
theme_override_font_sizes/font_size = 16
theme_override_colors/font_color = Color(1, 1, 1, 1)
theme_override_colors/placeholder_color = Color(0.5, 0.5, 0.5, 1)
secret = true

[node name="ConfirmPasswordStatus" type="Label" parent="CanvasLayer/RegisterBox/RegisterForm"]
text = ""
theme_override_font_sizes/font_size = 12

[node name="RegisterBtn" type="Button" parent="CanvasLayer/RegisterBox/RegisterForm"]
layout_mode = 2
custom_minimum_size = Vector2(250, 45)
text = "Create Account"
theme_override_colors/font_color = Color(0, 0, 0, 1)

[node name="SignInLinkBtn" type="Button" parent="CanvasLayer/RegisterBox/RegisterForm"]
layout_mode = 2
flat = true
text = "Already have an account? Sign In"
theme_override_font_sizes/font_size = 14
theme_override_colors/font_color = Color(1, 0.85, 0.35, 1)

[node name="BackToWelcomeBtn2" type="Button" parent="CanvasLayer/RegisterBox/RegisterForm"]
layout_mode = 2
flat = true
text = "← Back to Welcome"
theme_override_font_sizes/font_size = 12
theme_override_colors/font_color = Color(0.5, 0.5, 0.5, 1)

[node name="Notification" type="Label" parent="CanvasLayer"]
offset_left = 300.0
offset_top = 640.0
offset_right = 980.0
offset_bottom = 690.0
text = ""
horizontal_alignment = 1
theme_override_font_sizes/font_size = 14
theme_override_colors/font_color = Color(1, 0.3, 0.3, 1)

[connection signal="pressed" from="CanvasLayer/WelcomeBox/SignInBtnWelcome" to="." method="_go_to_sign_in"]
[connection signal="pressed" from="CanvasLayer/WelcomeBox/RegisterBtnWelcome" to="." method="_go_to_register"]
[connection signal="pressed" from="CanvasLayer/SignInBox/SignInForm/SignInBtn" to="." method="_on_sign_in_pressed"]
[connection signal="pressed" from="CanvasLayer/SignInBox/SignInForm/RegisterLinkBtn" to="." method="_go_to_register"]
[connection signal="pressed" from="CanvasLayer/SignInBox/SignInForm/BackToWelcomeBtn" to="." method="_go_to_welcome"]
[connection signal="pressed" from="CanvasLayer/MfaBox/MfaForm/MfaSubmitBtn" to="." method="_on_mfa_submit_pressed"]
[connection signal="pressed" from="CanvasLayer/MfaBox/MfaForm/MfaBackBtn" to="." method="_on_mfa_back_pressed"]
[connection signal="pressed" from="CanvasLayer/RegisterBox/RegisterForm/RegisterBtn" to="." method="_on_register_pressed"]
[connection signal="pressed" from="CanvasLayer/RegisterBox/RegisterForm/SignInLinkBtn" to="." method="_go_to_sign_in"]
[connection signal="pressed" from="CanvasLayer/RegisterBox/RegisterForm/BackToWelcomeBtn2" to="." method="_go_to_welcome"]
[connection signal="text_changed" from="CanvasLayer/RegisterBox/RegisterForm/NameInput" to="." method="_on_register_name_changed"]
[connection signal="text_changed" from="CanvasLayer/RegisterBox/RegisterForm/EmailInput2" to="." method="_on_register_email_changed"]
[connection signal="timeout" from="EmailCheckTimer" to="." method="_on_email_check_timer_timeout"]
[connection signal="timeout" from="NameCheckTimer" to="." method="_on_name_check_timer_timeout"]
