layout_mode = 2
size_flags_vertical = 3
script = ExtResource("2_dnd_card_list")

[node name="AvailablePanel" type="VBoxContainer" parent="CanvasLayer/MainRow/CenterColumn/PoolsRow"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 6

[node name="AvailableLabel" type="Label" parent="CanvasLayer/MainRow/CenterColumn/PoolsRow/AvailablePanel"]
