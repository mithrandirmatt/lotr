size_flags_vertical = 3
theme_override_constants/separation = 16

[node name="SelectedPanel" type="VBoxContainer" parent="CanvasLayer/MainRow/CenterColumn/PoolsRow"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 6

[node name="SelectedLabel" type="Label" parent="CanvasLayer/MainRow/CenterColumn/PoolsRow/SelectedPanel"]
layout_mode = 2
text = "In Deck (0)"
theme_override_font_sizes/font_size = 18
theme_override_colors/font_color = Color(1, 0.85, 0.35, 1)

[node name="SelectedList" type="ItemList" parent="CanvasLayer/MainRow/CenterColumn/PoolsRow/SelectedPanel"]
