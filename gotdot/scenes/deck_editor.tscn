autowrap_mode = 2
theme_override_font_sizes/font_size = 14
theme_override_colors/font_color = Color(0.8, 0.8, 0.8, 1)

[node name="PoolsRow" type="HBoxContainer" parent="CanvasLayer/MainRow/CenterColumn"]
