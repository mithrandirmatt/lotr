[gd_scene load_steps=2 format=3 uid="uid://lotr_deck_builder"]

[ext_resource type="Script" path="res://scripts/deck_builder.gd" id="1_deck_builder"]

; ── Deck Selection Screen ─────────────────────────────────────────────────
; First screen of the two-screen deck builder flow: list/create decks, then
; pick one to open the deck-editor screen (res://scenes/deck_editor.tscn).

[node name="DeckBuilder" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_deck_builder")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.05, 0.07, 0.15, 1)

[node name="CanvasLayer" type="CanvasLayer" parent="."]
layer = 1

[node name="BackBtn" type="Button" parent="CanvasLayer"]
offset_left = 20.0
offset_top = 16.0
offset_right = 170.0
offset_bottom = 56.0
flat = true
text = "< Back to Menu"
theme_override_font_sizes/font_size = 14
theme_override_colors/font_color = Color(0.8, 0.8, 0.8, 1)

[node name="TitleLabel" type="Label" parent="CanvasLayer"]
offset_left = 0.0
offset_top = 12.0
offset_right = 1280.0
offset_bottom = 60.0
text = "Your Decks"
theme_override_font_sizes/font_size = 32
theme_override_colors/font_color = Color(1, 0.85, 0.35, 1)
horizontal_alignment = 1

[node name="Notification" type="Label" parent="CanvasLayer"]
offset_left = 0.0
offset_top = 58.0
offset_right = 1280.0
offset_bottom = 82.0
text = ""
theme_override_font_sizes/font_size = 16
horizontal_alignment = 1

[node name="MainRow" type="HBoxContainer" parent="CanvasLayer"]
offset_left = 0.0
offset_top = 96.0
offset_right = 1280.0
offset_bottom = 700.0
alignment = 1

[node name="DecksPanel" type="VBoxContainer" parent="CanvasLayer/MainRow"]
custom_minimum_size = Vector2(480, 0)
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 10

[node name="DecksPanelLabel" type="Label" parent="CanvasLayer/MainRow/DecksPanel"]
layout_mode = 2
text = "My Decks (double-click or Edit to open)"
theme_override_font_sizes/font_size = 18
theme_override_colors/font_color = Color(1, 0.85, 0.35, 1)

[node name="DecksList" type="ItemList" parent="CanvasLayer/MainRow/DecksPanel"]
custom_minimum_size = Vector2(0, 460)
layout_mode = 2
size_flags_vertical = 3

[node name="NewDeckRow" type="HBoxContainer" parent="CanvasLayer/MainRow/DecksPanel"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="NewDeckNameInput" type="LineEdit" parent="CanvasLayer/MainRow/DecksPanel/NewDeckRow"]
layout_mode = 2
size_flags_horizontal = 3
placeholder_text = "New deck name"

[node name="NewDeckBtn" type="Button" parent="CanvasLayer/MainRow/DecksPanel/NewDeckRow"]
layout_mode = 2
text = "New Deck"

[node name="EditDeckBtn" type="Button" parent="CanvasLayer/MainRow/DecksPanel"]
layout_mode = 2
disabled = true
text = "Edit Selected Deck"

[connection signal="pressed" from="CanvasLayer/BackBtn" to="." method="_on_back_pressed"]
[connection signal="pressed" from="CanvasLayer/MainRow/DecksPanel/NewDeckRow/NewDeckBtn" to="." method="_on_new_deck_pressed"]
[connection signal="item_selected" from="CanvasLayer/MainRow/DecksPanel/DecksList" to="." method="_on_deck_selected"]
[connection signal="item_activated" from="CanvasLayer/MainRow/DecksPanel/DecksList" to="." method="_on_deck_item_activated"]
[connection signal="pressed" from="CanvasLayer/MainRow/DecksPanel/EditDeckBtn" to="." method="_on_edit_deck_pressed"]
