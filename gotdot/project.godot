; Engine configuration file.
; It's best edited using the editor.
;
; https://docs.godotengine.org/

config_version=5

[application]

config/name="LotR TCG"
config/description="Lord of the Rings Trading Card Game - Digital Implementation"
run/main_scene="res://scenes/startup.tscn"
config/features=PackedStringArray("4.4", "Forward Plus")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

; Forward+ (Vulkan) for desktop: full PBR, real-time shadows, best 3D quality.
; Switch to "mobile" (OpenGL ES 3) if web/mobile export is needed later.
renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
