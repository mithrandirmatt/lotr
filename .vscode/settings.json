{
    "editor.renderWhitespace": "all",

    // ------------------------------------------------------------
    // Python -- workspace-safe interpreter strategy
    // Avoid hardcoding OS-specific interpreter executables here.
    // Let each runtime (Windows / WSL / container) resolve `python`
    // and discover local virtual environments.
    // ------------------------------------------------------------
    "python.defaultInterpreterPath": "python",
    "python.venvFolders": [
        "venv",
        ".venv"
    ],
    "python.terminal.activateEnvironment": true,

    // ------------------------------------------------------------
    // GitHub Copilot -- local Ollama language model (BYOM)
    // Requires Ollama running on the host with OLLAMA_ORIGINS=*
    // set as a system/user environment variable, then Ollama restarted.
    //
    // To set on Windows (run once per machine, then relaunch Ollama):
    //   [System.Environment]::SetEnvironmentVariable("OLLAMA_ORIGINS","*","User")
    //
    // Use direct host Ollama by default (no proxy/headroom in the request path).
    "github.copilot.chat.languageModel.ollama.serverUrl": "http://localhost:11434",
    "github.copilot.chat.languageModel.ollama.model": "lotr-agentic-rx7900xtx-agentic-qwen35-262k:latest",

    // Auto-run task on workspace startup
    "tasks.onTaskStart": "Setup LOTR Docker Workspace"
}
